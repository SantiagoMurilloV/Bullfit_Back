# =============================================================================
# Bullfit Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# ---- Server -----------------------------------------------------------------
# Port the Express app listens on. DigitalOcean App Platform injects PORT
# automatically; locally, default to 8084.
PORT=8084

# Node environment. Use "production" in DO, "development" locally.
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----------------------------------------------
# Full connection string with username:password@cluster URL.
# In production, restrict the Atlas IP allowlist to the DO egress IPs.
MONGODB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins. NO wildcard "*" in production.
# Example: https://bullfit.app,https://bullfit-web-v2-0.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---- Redis (optional cache) -------------------------------------------------
# Set REDIS_ENABLED=true to enable cache layer for reservations/users/finances.
# If disabled the app falls back to direct DB queries.
REDIS_ENABLED=false
# Either provide REDIS_URL OR the host/port/password trio:
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional override for the reservations list cache TTL in seconds.
# Default is 0 (no expiration). Use a number >0 for safer behavior.
RESERVATIONS_CACHE_TTL=

# ---- Twilio (SMS / WhatsApp) ------------------------------------------------
# Used by helpers/twilio_route (currently disabled in app.js). Keep credentials
# off the repo; rotate AUTH_TOKEN periodically and set spend caps in Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Telegram bot (admin notifications only) -------------------------------
# Bot token from @BotFather. ROTATE if it ever lived in source code.
TELEGRAM_BOT_TOKEN=
# Chat ID that receives admin notifications (usually a single admin user).
TELEGRAM_ADMIN_CHAT_ID=

# ---- n8n webhook (admin automations) ---------------------------------------
# Full webhook URL (https://...). Do NOT hardcode in source.
N8N_WEBHOOK_URL=

# ---- Firebase Admin (DEPRECATED, migrating to Supabase Storage) ------------
# Path to the service-account JSON file OR the JSON contents inline.
# Both keys below were committed to the repo in the past and MUST be rotated.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_TERMS_SERVICE_ACCOUNT_PATH=

# ---- Supabase (planned: PDF storage replacement for Firebase) --------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=bullfit-terms

# ---- Auth (planned: JWT-based real auth) -----------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
# Token expiry. Examples: 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# ---- Observability (planned: Sentry) ---------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
